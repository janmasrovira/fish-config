#!/usr/bin/env fish
#
# Fetches secrets from Bitwarden and writes them to
# ~/.config/fish/conf.d/secrets.fish (which is gitignored and auto-sourced
# by fish at shell startup).
#
# Run once after cloning the dotfiles, and again whenever a secret rotates.
# Requires: bw (Bitwarden CLI), yq.
#
# Manifest lives in bin/secrets-manifest.yaml — add entries there.

set -l config (status dirname)/secrets-manifest.yaml
set -l out    ~/.config/fish/conf.d/secrets.fish

for cmd in bw yq
    if not type -q $cmd
        echo "error: $cmd is required but not installed" >&2
        exit 1
    end
end

if not yq --version 2>/dev/null | string match -q '*mikefarah*'
    echo "error: this script requires mikefarah/yq (on Arch: go-yq)," >&2
    echo "       not the PyPI yq. See README." >&2
    exit 1
end

if not test -e $config
    echo "error: manifest not found: $config" >&2
    exit 1
end

# Ensure we have a logged-in, unlocked session. Both bw login and bw unlock
# are interactive. A stale $BW_SESSION shows up as status "locked" and falls
# through to the unlock branch.
set -l bw_status (bw status | yq -r -p=json '.status')
switch $bw_status
    case unauthenticated
        set -gx BW_SESSION (bw login --raw)
        or begin; echo "error: bw login failed" >&2; exit 1; end
    case locked
        set -gx BW_SESSION (bw unlock --raw)
        or begin; echo "error: bw unlock failed" >&2; exit 1; end
    case unlocked
        # $BW_SESSION is already valid
    case '*'
        echo "error: unexpected bw status: $bw_status" >&2; exit 1
end

bw sync >/dev/null
or begin
    echo "error: bw sync failed" >&2
    exit 1
end

set -l entries (yq -e -r '.secrets[] | .item + "|" + .field + "|" + .env' $config)
or begin
    echo "error: failed to parse manifest $config" >&2
    exit 1
end

set -l tmp (mktemp)
function __cleanup --on-event fish_exit --inherit-variable tmp
    rm -f $tmp
end

echo "# Generated by bin/init-secrets.fish — do not edit by hand." >$tmp
echo "# Re-run the script to refresh." >>$tmp

set -l written
for line in $entries
    set -l parts (string split '|' -- $line)
    if test (count $parts) -ne 3
        echo "error: malformed manifest entry: $line" >&2
        exit 1
    end
    set -l item   $parts[1]
    set -l field  $parts[2]
    set -l envvar $parts[3]

    set -l value (bw get item "$item" \
        | env f=$field yq -e -p=json '.fields[] | select(.name == strenv(f)) | .value')
    if test $pipestatus[1] -ne 0 -o $pipestatus[2] -ne 0
        echo "error: could not read field '$field' from item '$item'" >&2
        exit 1
    end

    echo "set --export $envvar "(string escape -- $value) >>$tmp
    set -a written $envvar
end

mkdir -p (dirname $out)
mv $tmp $out
chmod 600 $out

for name in $written
    echo "wrote $name"
end
echo "→ $out"
